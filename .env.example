# --- Frontend (finiscono nel bundle: SOLO chiavi pubbliche) ---
# Le trovi in Firebase console > Impostazioni progetto > Le tue app > Web.
# Non sono segrete: quello che tiene chiuso il database sono firestore.rules.
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=salone-solarino.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=salone-solarino
VITE_FIREBASE_STORAGE_BUCKET=salone-solarino.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Dominio di produzione, senza / finale — usato per il QR code in /installa.
VITE_SITE_URL=https://dominio-del-salone.it

# --- Cloud Functions ---
# EMAIL_MITTENTE e EMAIL_TITOLARE sono parametri:
#   firebase functions:config non serve più, si impostano al deploy oppure
#   in functions/.env
# RESEND_API_KEY è un secret, NON un parametro:
#   firebase functions:secrets:set RESEND_API_KEY
EMAIL_MITTENTE=prenotazioni@dominio-del-salone.it
EMAIL_TITOLARE=titolare@dominio-del-salone.it

# --- Solo per gli script da riga di comando ---
# Chiave del service account (Firebase console > Account di servizio).
# NON va nel repository e NON va nel bundle.
GOOGLE_APPLICATION_CREDENTIALS=./chiave-servizio.json

# --- Solo per il travaso una tantum da Supabase (migra-a-firestore.mjs) ---
# Si possono cancellare a travaso finito.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
