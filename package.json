{
  "name": "salone-solarino",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:disponibilita": "npm --prefix functions run build && node scripts/test-disponibilita.mjs",
    "emulatori": "firebase emulators:start",
    "semina": "node --env-file=.env scripts/semina-firestore.mjs",
    "crea:admin": "node --env-file=.env scripts/crea-admin.mjs",
    "migra": "node --env-file=.env scripts/migra-a-firestore.mjs",
    "verifica:regole": "node --env-file=.env scripts/verifica-regole.mjs",
    "verifica:agenda": "node --env-file=.env scripts/verifica-agenda-giorno.mjs",
    "prova:pulizia": "npm --prefix functions run build && node --env-file=.env scripts/prova-pulizia.mjs",
    "test:prenota": "node --env-file=.env scripts/test-prenota.mjs",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "firebase-admin": "^13.6.0",
    "oxlint": "^1.79.0",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
